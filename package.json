{
  "name": "nemesis",
  "private": true,
  "version": "0.1.0",
  "description": "NEMESIS — Kalshi-native desktop trading command center",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nemesis/desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run build -w @nemesis/desktop && npm run test:e2e -w @nemesis/desktop",
    "package": "npm run package -w @nemesis/global-event-alpha && npm run package -w @nemesis/desktop",
    "package:local-signed": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows-local.ps1 -Package -TrustCurrentUser",
    "ci:build": "npm run build",
    "ci:typecheck": "npm run typecheck",
    "ci:unit": "npm test -- --run",
    "ci:e2e": "node apps/desktop/e2e/ci-smoke.cjs",
    "ci:package": "npm run package"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.10.6",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "framer-motion": {
      "motion-dom": "12.23.23",
      "motion-utils": "12.23.6"
    },
    "vite": {
      "esbuild": "0.28.1"
    }
  }
}
