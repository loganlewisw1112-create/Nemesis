{
  "name": "@nemesis/global-event-alpha",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "npx tsc --noEmit",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:sqlite",
    "package": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@nemesis/brain-core": "*",
    "@nemesis/bridge-contracts": "*",
    "@nemesis/connectors": "*",
    "@nemesis/core": "*",
    "@nemesis/simulation-core": "*",
    "@nemesis/ui": "*",
    "better-sqlite3": "^12.11.1",
    "framer-motion": "^12.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "cc.nemesis.gea",
    "productName": "Global Event Alpha",
    "electronVersion": "42.5.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": true
    }
  }
}
